{
  "name": "math-quest",
  "main": "./worker/index.js",
  "compatibility_date": "2026-06-23",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "ai": { "binding": "AI" },
  "kv_namespaces": [
    { "binding": "KIDS", "id": "71681b4e9b8445739d2069cf615fadf9" }
  ],
  "vars": {
    "NEBIUS_BASE_URL": "https://api.tokenfactory.nebius.com/v1",
    "DM_MODEL": "nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B",
    "DM_MODEL_SCENE": "nvidia/nemotron-3-super-120b-a12b"
  }
  // NEBIUS_API_KEY is a secret:  npx wrangler secret put NEBIUS_API_KEY
  // local dev: put NEBIUS_API_KEY=... in .dev.vars (gitignored)
}
