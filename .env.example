# Copy to .env (gitignored). Never commit real keys.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Text model for the DM (NVIDIA open model on Nebius Token Factory).
# Exact ID must be confirmed against GET /v1/models once the key exists:
#   python scripts/list_models.py nemotron
DM_MODEL=nvidia/Llama-3_3-Nemotron-Super-49B-v1_5
# Image model for the monster pack (confirmed in Nebius docs)
IMAGE_MODEL=black-forest-labs/flux-schnell
